<Window x:Class="WarehouseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Складской учёт" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковое меню -->
        <Border Grid.Column="0" Background="#161B22">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="📦 СКЛАДУЧЕТ" FontSize="20" FontWeight="Bold" Foreground="#58A6FF" 
                           HorizontalAlignment="Center" Margin="0,0,0,35"/>

                <RadioButton x:Name="navProducts" Content="📦 Товары" Style="{StaticResource DarkNavButtonStyle}" 
                             GroupName="Navigation" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="navStock" Content="📊 Остатки" Style="{StaticResource DarkNavButtonStyle}" 
                             GroupName="Navigation" Checked="Nav_Checked"/>
                <RadioButton x:Name="navCounterparties" Content="🏢 Контрагенты" Style="{StaticResource DarkNavButtonStyle}" 
                             GroupName="Navigation" Checked="Nav_Checked"/>
                <RadioButton x:Name="navContacts" Content="📞 Контакты" Style="{StaticResource DarkNavButtonStyle}" 
                             GroupName="Navigation" Checked="Nav_Checked"/>
                <RadioButton x:Name="navOperations" Content="🔄 Операции" Style="{StaticResource DarkNavButtonStyle}" 
                             GroupName="Navigation" Checked="Nav_Checked"/>
                <RadioButton x:Name="navOperationItems" Content="📋 Детали операций" Style="{StaticResource DarkNavButtonStyle}" 
                             GroupName="Navigation" Checked="Nav_Checked"/>
                <RadioButton x:Name="navAnalytics" Content="📈 Аналитика" Style="{StaticResource DarkNavButtonStyle}" 
                             GroupName="Navigation" Checked="Nav_Checked"/>
            </StackPanel>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Column="1" Background="#0D1117">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0" Background="#161B22" BorderBrush="#21262D" BorderThickness="0,0,0,1">
                <Grid Margin="20,0">
                    <TextBlock x:Name="titleText" Text="Товары" VerticalAlignment="Center" 
                               FontSize="24" FontWeight="SemiBold" Foreground="#E6EDF3"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="addButton" Content="➕ Добавить" Style="{StaticResource DarkPrimaryButton}" 
                                Click="AddButton_Click" Margin="0,0,12,0"/>
                        <Button x:Name="deleteButton" Content="🗑 Удалить" Style="{StaticResource DarkDangerButton}" 
                                Click="DeleteButton_Click" Margin="0,0,12,0"/>
                        <Button Content="🔄 Обновить" Style="{StaticResource DarkSecondaryButton}" 
                                Click="RefreshButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Фильтры -->
            <Border x:Name="filtersBorder" Grid.Row="1" Background="#161B22" Margin="20,15,20,0" CornerRadius="10" 
                    Padding="15" BorderBrush="#21262D" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍 Поиск:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#8B949E"/>
                    <TextBox x:Name="searchBox" Width="220" Margin="0,0,25,0" 
                             Style="{StaticResource DarkTextBox}" TextChanged="SearchBox_TextChanged"/>

                    <TextBlock x:Name="filterLabel" Text="🎯 Фильтр:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#8B949E"/>
                    <ComboBox x:Name="filterCombo" Width="150" Style="{StaticResource DarkComboBox}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Таблица -->
            <Border x:Name="gridBorder" Grid.Row="2" Background="#161B22" Margin="20" CornerRadius="10" 
                    BorderBrush="#21262D" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid x:Name="dataGrid" AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionMode="Single" SelectionUnit="FullRow"
                              RowHeight="42" HeadersVisibility="Column"
                              BorderThickness="0" 
                              Background="#161B22"
                              Foreground="#E6EDF3"
                              GridLinesVisibility="Horizontal"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2D3A5E"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#161B22"/>

                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0D1117"/>
                                <Setter Property="Foreground" Value="#58A6FF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="#21262D"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>

                            <Style TargetType="DataGridCell">

                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Foreground" Value="#87CEFA"/>
                                <Setter Property="BorderBrush" Value="#21262D"/>

                            </Style>

                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#161B22"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2D3A5E"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#21262D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                    </DataGrid>
                </ScrollViewer>
            </Border>

            <!-- Панель аналитики -->
            <Grid x:Name="analyticsPanel" Grid.Row="1" Grid.RowSpan="2" Margin="20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Вкладки аналитики -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <RadioButton x:Name="tabTopProducts" Content="🔥 Лидеры продаж" Style="{StaticResource DarkNavButtonStyle}" 
                                 GroupName="AnalyticsTabs" IsChecked="True" Checked="AnalyticsTab_Checked" Margin="0,0,10,0" Height="36"/>
                    <RadioButton x:Name="tabTurnover" Content="📈 Обороты по дням" Style="{StaticResource DarkNavButtonStyle}" 
                                 GroupName="AnalyticsTabs" Checked="AnalyticsTab_Checked" Margin="0,0,10,0" Height="36"/>
                    <RadioButton x:Name="tabLowStock" Content="⚠️ Дефицит на складе" Style="{StaticResource DarkNavButtonStyle}" 
                                 GroupName="AnalyticsTabs" Checked="AnalyticsTab_Checked" Height="36"/>
                </StackPanel>

                <!-- Содержимое вкладок -->
                <Border Grid.Row="1" Background="#161B22" CornerRadius="10" BorderBrush="#21262D" BorderThickness="1" Padding="20">
                    <Grid>
                        <!-- Лидеры продаж -->
                        <Grid x:Name="panelTopProducts" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="С:" VerticalAlignment="Center" Foreground="#8B949E" Margin="0,0,5,0"/>
                                <DatePicker x:Name="dpTopFrom" Width="120" Margin="0,0,15,0"/>
                                
                                <TextBlock Text="По:" VerticalAlignment="Center" Foreground="#8B949E" Margin="0,0,5,0"/>
                                <DatePicker x:Name="dpTopTo" Width="120" Margin="0,0,15,0"/>
                                
                                <TextBlock Text="Лимит:" VerticalAlignment="Center" Foreground="#8B949E" Margin="0,0,5,0"/>
                                <TextBox x:Name="txtTopLimit" Text="10" Width="50" Margin="0,0,20,0" Style="{StaticResource DarkTextBox}"/>
                                
                                <Button Content="🔍 Рассчитать" Style="{StaticResource DarkPrimaryButton}" Click="BtnLoadTopProducts_Click"/>
                            </StackPanel>
                            
                            <DataGrid Grid.Row="1" x:Name="dgTopProducts" AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="#161B22" Foreground="#E6EDF3" RowHeight="38" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="60"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding ProductName}" Width="250"/>
                                    <DataGridTextColumn Header="Артикул" Binding="{Binding ProductArticle}" Width="120"/>
                                    <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit}" Width="80"/>
                                    <DataGridTextColumn Header="Продано (кол-во)" Binding="{Binding TotalQuantity}" Width="150"/>
                                    <DataGridTextColumn Header="Выручка" Binding="{Binding FormattedAmount}" Width="150"/>
                                    <DataGridTextColumn Header="Продаж (кол-во)" Binding="{Binding OperationsCount}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Обороты по дням -->
                        <Grid x:Name="panelTurnover" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="С:" VerticalAlignment="Center" Foreground="#8B949E" Margin="0,0,5,0"/>
                                <DatePicker x:Name="dpTurnoverFrom" Width="120" Margin="0,0,15,0"/>
                                
                                <TextBlock Text="По:" VerticalAlignment="Center" Foreground="#8B949E" Margin="0,0,5,0"/>
                                <DatePicker x:Name="dpTurnoverTo" Width="120" Margin="0,0,20,0"/>
                                
                                <Button Content="📈 Показать отчет" Style="{StaticResource DarkPrimaryButton}" Click="BtnLoadTurnover_Click"/>
                            </StackPanel>

                            <!-- Суммарные карточки -->
                            <Grid Grid.Row="1" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1F2A38" BorderBrush="#388BFD" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="📥 ВСЕГО ПРИХОД" FontSize="11" Foreground="#58A6FF" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtTotalIncome" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#1B2D24" BorderBrush="#30A14E" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="📤 ВСЕГО ПРОДАЖИ" FontSize="11" Foreground="#39D353" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtTotalSales" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#351C1C" BorderBrush="#F85149" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="🗑 ВСЕГО СПИСАНО" FontSize="11" Foreground="#FF7B72" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtTotalWriteoff" Text="0 ₽" FontSize="20" FontWeight="Bold" Foreground="#E6EDF3" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            
                            <DataGrid Grid.Row="2" x:Name="dgTurnover" AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="#161B22" Foreground="#E6EDF3" RowHeight="38" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding FormattedDate}" Width="150"/>
                                    <DataGridTextColumn Header="Сумма прихода" Binding="{Binding FormattedIncome}" Width="200"/>
                                    <DataGridTextColumn Header="Сумма продаж" Binding="{Binding FormattedSale}" Width="200"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- Дефицит на складе -->
                        <Grid x:Name="panelLowStock" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Порог остатка:" VerticalAlignment="Center" Foreground="#8B949E" Margin="0,0,10,0"/>
                                <TextBox x:Name="txtMinQty" Text="5" Width="60" Margin="0,0,20,0" Style="{StaticResource DarkTextBox}"/>
                                
                                <Button Content="⚠️ Найти дефицит" Style="{StaticResource DarkPrimaryButton}" Click="BtnLoadLowStock_Click"/>
                            </StackPanel>
                            
                            <DataGrid Grid.Row="1" x:Name="dgLowStock" AutoGenerateColumns="False" IsReadOnly="True" 
                                      Background="#161B22" Foreground="#E6EDF3" RowHeight="38" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID товара" Binding="{Binding ProductId}" Width="100"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding ProductName}" Width="300"/>
                                    <DataGridTextColumn Header="Артикул" Binding="{Binding ProductArticle}" Width="150"/>
                                    <DataGridTextColumn Header="Текущий остаток" Binding="{Binding CurrentQuantityWarning}" Width="150"/>
                                    <DataGridTextColumn Header="Ед. изм." Binding="{Binding Unit}" Width="100"/>
                                    <DataGridTextColumn Header="Минимальный порог" Binding="{Binding MinQuantity}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Статус-бар -->
            <StatusBar Grid.Row="2" VerticalAlignment="Bottom" Background="#161B22" 
                       Foreground="#8B949E" Height="32">
                <StatusBarItem>
                    <TextBlock x:Name="statusText" Text="Готово" />
                </StatusBarItem>
                <Separator Style="{StaticResource DarkSeparator}"/>
                <StatusBarItem>
                    <TextBlock Text="⚡ Складская система" Margin="10,0,0,0"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>